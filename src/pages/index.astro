---
// Pantalla de entrada: elegir idioma. Si la persona ya eligió antes, entra directo.
import '../styles/global.css';
import { perfil } from '../data/perfil';
import { ruta } from '../data/util';

const es = ruta('/es/');
const en = ruta('/en/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{perfil.nombre} · {perfil.cargo}</title>
    <meta name="description" content="Portafolio de Paid Media y Growth: casos reales de Meta Ads y Google Ads. / Paid Media & Growth portfolio: real Meta Ads and Google Ads case studies." />
    <link rel="alternate" hreflang="es" href={new URL('/es/', perfil.url).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', perfil.url).href} />
    <meta name="theme-color" content="#0b1f4d" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ es, en }}>
      try {
        const guardado = localStorage.getItem('idioma');
        if (guardado === 'es' || guardado === 'en') location.replace(guardado === 'es' ? es : en);
      } catch (e) {}
    </script>
  </head>
  <body class="bg-azul-oscuro text-white">
    <main class="relative flex min-h-svh items-center overflow-hidden">
      <div class="pointer-events-none absolute -right-40 -top-40 size-[28rem] rounded-full bg-azul opacity-40 blur-3xl"></div>
      <div class="contenedor relative py-16">
        <p class="etiqueta text-white/60">{perfil.cargo}</p>
        <h1 class="mt-4 text-5xl font-extrabold leading-none md:text-7xl">
          {perfil.nombre}<span class="text-rojo">.</span>
        </h1>
        <p class="mt-8 text-lg text-white/80">
          Elige tu idioma <span class="text-white/40">·</span> Choose your language
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={es} hreflang="es" lang="es" class="btn-cta min-w-44">Español</a>
          <a href={en} hreflang="en" lang="en" class="btn-secundario min-w-44 text-white">English</a>
        </div>
      </div>
    </main>
  </body>
</html>
