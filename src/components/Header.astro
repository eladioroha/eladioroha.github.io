---
import { ui, type Idioma } from '../data/perfil';
import { ruta } from '../data/util';

interface Props { idioma: Idioma; alternativa: string }
const { idioma, alternativa } = Astro.props;
const t = ui[idioma];
const inicio = ruta(`/${idioma}/`);
---
<header class="sticky top-0 z-30 border-b border-tinta/10 bg-white/90 backdrop-blur">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a href={inicio} class="flex items-center gap-2 font-titulo font-extrabold text-azul-oscuro" aria-label="Eladio Rojas">
      <span class="flex size-9 items-center justify-center rounded-xl bg-azul-oscuro text-sm text-white">ER<span class="text-rojo">.</span></span>
      <span class="hidden sm:inline">Eladio Rojas</span>
    </a>
    <nav class="hidden items-center gap-1 rounded-full bg-superficie p-1 text-sm font-medium text-tinta-suave ring-1 ring-tinta/10 md:flex">
      <a href={`${inicio}#casos`} class="rounded-full px-4 py-2 hover:bg-white hover:text-azul-oscuro">{t.nav.casos}</a>
      <a href={`${inicio}#proceso`} class="rounded-full px-4 py-2 hover:bg-white hover:text-azul-oscuro">{t.nav.proceso}</a>
      <a href={`${inicio}#prisma`} class="rounded-full px-4 py-2 hover:bg-white hover:text-azul-oscuro">{t.nav.prisma}</a>
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={ruta(alternativa)}
        hreflang={idioma === 'es' ? 'en' : 'es'}
        class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-tinta-suave hover:text-azul-oscuro"
      >{t.otroIdioma}</a>
      <a href={`${inicio}#contacto`} class="inline-flex min-h-11 items-center rounded-lg bg-rojo px-4 text-sm font-semibold text-white hover:brightness-110">
        {t.nav.contacto}
      </a>
    </div>
  </div>
</header>
