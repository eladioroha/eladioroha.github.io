---
// Herramientas agrupadas por categoría. Íconos de Simple Icons (CC0) en el color de cada marca.
import * as simpleIcons from 'simple-icons';
import { ui, herramientas, type Idioma } from '../data/perfil';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = ui[idioma];

type Icono = { path: string; hex: string };
function icono(slug?: string): Icono | undefined {
  if (!slug) return undefined;
  const clave = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}` as keyof typeof simpleIcons;
  return simpleIcons[clave] as Icono | undefined;
}

// Colores muy claros (como el amarillo de Mailchimp) no se leen sobre blanco: se usa la tinta.
function colorLegible(hex: string): string {
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const luz = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return luz > 0.75 ? '#0f1b33' : `#${hex}`;
}

const iniciales = (nombre: string) =>
  nombre.split(/\s+/).filter((p) => /^[A-Z]/.test(p)).slice(0, 2).map((p) => p[0]).join('');
---
<section id="herramientas" class="seccion border-t border-tinta/10">
  <div class="contenedor">
    <h2 class="font-serif text-4xl font-semibold text-azul-oscuro md:text-5xl">{t.herramientasTitulo}</h2>
    <p class="mt-3 max-w-2xl text-lg text-tinta-suave">{t.herramientasBajada}</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {herramientas.map((grupo, n) => (
        <div class:list={['tarjeta p-6', n < 3 ? 'lg:col-span-2' : 'lg:col-span-3']} data-revelar>
          <h3 class="etiqueta text-azul">{grupo.categoria[idioma]}</h3>
          <ul class="mt-4 space-y-3">
            {grupo.items.map((h) => {
              const i = icono(h.icono);
              return (
                <li class="flex items-center gap-3">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-superficie ring-1 ring-tinta/5">
                    {i ? (
                      <svg viewBox="0 0 24 24" class="size-5" fill={colorLegible(i.hex)} aria-hidden="true"><path d={i.path} /></svg>
                    ) : (
                      <span class="font-titulo text-xs font-extrabold text-azul" aria-hidden="true">{iniciales(h.nombre)}</span>
                    )}
                  </span>
                  <span class="font-medium text-tinta">{h.nombre}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
