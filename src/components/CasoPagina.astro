---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Contacto from './Contacto.astro';
import Grafico from './Grafico.astro';
import { ui, type Idioma } from '../data/perfil';
import type { Caso } from '../data/casos';
import { cifra, marcar, ruta, visible } from '../data/util';

interface Props { caso: Caso; idioma: Idioma }
const { caso: c, idioma } = Astro.props;
const t = ui[idioma];
const otro = idioma === 'es' ? 'en' : 'es';
const ficha = [
  [t.ficha.rubro, c.rubro[idioma]],
  [t.ficha.periodo, c.periodo[idioma]],
  [t.ficha.plataformas, c.plataformas],
  [t.ficha.inversion, c.inversion[idioma]],
].filter(([, v]) => visible(v));
const estrategia = c.estrategia.filter((e) => visible(e[idioma]));
const resultados = c.resultados.filter((r) => visible(r[idioma]));
const aprendizaje = visible(c.aprendizaje[idioma]);
---
<Base
  idioma={idioma}
  titulo={`${c.marca} · ${t.metaTitulo.split(' · ')[0]}`}
  descripcion={c.titular[idioma]}
  alternativa={`/${otro}/casos/${c.slug}/`}
>
  <Header idioma={idioma} alternativa={`/${otro}/casos/${c.slug}/`} />

  <main>
    <section class="bg-azul-oscuro text-white">
      <div class="contenedor pb-14 pt-10 md:pb-20 md:pt-14">
        <a href={ruta(`/${idioma}/#casos`)} class="inline-flex min-h-11 items-center text-sm font-semibold text-white/70 hover:text-white">{t.volver}</a>
        <p class="etiqueta mt-6 text-white/70">
          {c.marca}
        </p>
        <h1 class="mt-3 max-w-4xl text-3xl font-extrabold leading-tight md:text-5xl">{c.titular[idioma]}</h1>

        <dl class="mt-10 grid gap-px overflow-hidden rounded-2xl bg-white/15 sm:grid-cols-3">
          {c.metricas.map((m) => (
            <div class="bg-azul-oscuro p-5">
              <dt class="sr-only">{m.etiqueta[idioma]}</dt>
              <dd>
                <span class="block font-titulo text-3xl font-extrabold">{cifra(m.valor, idioma)}</span>
                <span class="mt-1 block text-sm text-white/70">{m.etiqueta[idioma]}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <div class="contenedor grid gap-12 py-12 md:py-16 lg:grid-cols-[16rem_1fr]">
      <aside>
        <dl class="tarjeta divide-y divide-tinta/10 lg:sticky lg:top-24">
          {ficha.map(([k, v]) => (
            <div class="p-4">
              <dt class="etiqueta text-tinta-suave">{k}</dt>
              <dd class="mt-1 font-semibold text-azul-oscuro" set:html={marcar(v)} />
            </div>
          ))}
        </dl>
      </aside>

      <article class="max-w-2xl space-y-12">
        <section>
          <h2 class="text-2xl font-extrabold text-azul-oscuro">{t.secciones.contexto}</h2>
          <p class="mt-4 text-lg leading-relaxed text-tinta-suave" set:html={marcar(c.contexto[idioma])} />
        </section>

        <section>
          <h2 class="text-2xl font-extrabold text-azul-oscuro">{t.secciones.problema}</h2>
          <p class="mt-4 text-lg leading-relaxed text-tinta-suave" set:html={marcar(c.problema[idioma])} />
        </section>

        {estrategia.length > 0 && <section>
          <h2 class="text-2xl font-extrabold text-azul-oscuro">{t.secciones.estrategia}</h2>
          <ul class="mt-4 space-y-3">
            {estrategia.map((e) => (
              <li class="flex gap-3 text-lg leading-relaxed text-tinta-suave">
                <span class="mt-2.5 size-2 shrink-0 rounded-full bg-rojo" aria-hidden="true"></span>
                <span set:html={marcar(e[idioma])} />
              </li>
            ))}
          </ul>
        </section>}

        {(resultados.length > 0 || c.graficos.length > 0) && <section>
          <h2 class="text-2xl font-extrabold text-azul-oscuro">{t.secciones.resultados}</h2>
          <ul class="mt-4 space-y-3">
            {resultados.map((r) => (
              <li class="flex gap-3 text-lg leading-relaxed text-tinta">
                <span class="mt-1 font-bold text-azul" aria-hidden="true">✓</span>
                <span set:html={marcar(r[idioma])} />
              </li>
            ))}
          </ul>
          {c.graficos.length > 0 && (
            <div class="mt-8 grid gap-5">
              {c.graficos.map((g) => <Grafico grafico={g} idioma={idioma} />)}
            </div>
          )}
          <p class="mt-4 text-xs text-tinta-suave">{t.notaCifras}</p>
        </section>}

        {aprendizaje && <section class="rounded-2xl border-l-4 border-rojo bg-superficie p-6">
          <h2 class="etiqueta text-rojo">{t.secciones.aprendizaje}</h2>
          <p class="mt-3 text-lg font-medium leading-relaxed text-azul-oscuro" set:html={marcar(c.aprendizaje[idioma])} />
        </section>}
      </article>
    </div>

    <Contacto idioma={idioma} />
  </main>
</Base>
