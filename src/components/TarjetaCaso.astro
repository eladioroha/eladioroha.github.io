---
// Tarjeta de caso en la home: desafío, enfoque, resultados y aprendizaje, más las métricas de impacto.
import Icono from './Icono.astro';
import { ui, type Idioma } from '../data/perfil';
import type { Caso } from '../data/casos';
import { cifra, ruta } from '../data/util';

interface Props { caso: Caso; idioma: Idioma }
const { caso: c, idioma } = Astro.props;
const t = ui[idioma];

// Primera oración de un texto, para la versión corta de la tarjeta.
const primera = (texto: string) => texto.split(/(?<=[.!?])\s+(?=[A-ZÁÉÍÓÚÑ¿])/)[0];

const bloques = [
  { clave: 'desafio', color: 'text-rojo bg-rojo/10', texto: primera(c.problema[idioma]) },
  { clave: 'enfoque', color: 'text-azul bg-azul/10', texto: c.estrategia[0][idioma] },
  { clave: 'resultados', color: 'text-emerald-700 bg-emerald-600/10', texto: c.resultados.slice(0, 2).map((r) => r[idioma]).join(' ') },
  { clave: 'aprendizaje', color: 'text-amber-700 bg-amber-500/15', texto: primera(c.aprendizaje[idioma]) },
] as const;
---
<article
  class="tarjeta flex flex-col overflow-hidden shadow-[0_1px_2px_rgba(15,27,51,0.04)]"
  data-caso
  data-enfoques={c.enfoques.join(' ')}
>
  <div class="p-6 sm:p-7">
    <div class="flex min-h-10 items-center justify-between gap-3">
      {c.logos && c.logos.length > 0 ? (
        <div class="flex items-center gap-4">
          {c.logos.map((l) => (
            <img src={ruta(`/logos/${l}`)} alt="" class="logo-marca max-h-9 max-w-32 object-contain" loading="lazy" />
          ))}
        </div>
      ) : (
        <span class="font-titulo text-xl font-extrabold uppercase tracking-wide text-tinta/80">{c.marca}</span>
      )}
      <span class="shrink-0 rounded-full bg-superficie px-3 py-1 text-xs font-semibold text-azul">
        {t.enfoques[c.enfoques[0]].titulo}
      </span>
    </div>

    <h3 class="mt-5 text-xl font-extrabold leading-snug text-azul-oscuro">{c.titular[idioma]}</h3>
    <ul class="mt-3 flex flex-wrap gap-1.5 text-xs text-tinta-suave">
      <li class="rounded-md bg-superficie px-2 py-1">{c.marca}</li>
      <li class="rounded-md bg-superficie px-2 py-1">{c.rubro[idioma]}</li>
      <li class="rounded-md bg-superficie px-2 py-1">{c.plataformas.split(' · ')[0]}</li>
    </ul>

    <dl class="mt-6 space-y-4">
      {bloques.map((b) => (
        <div class="flex gap-3">
          <span class:list={['mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full', b.color]}>
            <Icono nombre={b.clave} size={16} />
          </span>
          <div>
            <dt class="text-sm font-bold text-tinta">{t.bloques[b.clave]}</dt>
            <dd class="mt-0.5 text-sm leading-relaxed text-tinta-suave">{b.texto}</dd>
          </div>
        </div>
      ))}
    </dl>

    <div class="mt-7">
      <div class="flex items-center justify-between">
        <p class="text-sm font-bold text-tinta">{t.impacto}</p>
        <span class="rounded-full bg-amber-500/15 px-2.5 py-0.5 text-xs font-medium text-amber-800">{t.aproximadas}</span>
      </div>
      <dl class="mt-3 grid grid-cols-3 gap-2">
        {c.metricas.map((m) => (
          <div class="rounded-xl bg-superficie px-2 py-3 text-center">
            <dd class="font-titulo text-base font-extrabold leading-tight text-azul sm:text-lg">{cifra(m.valor, idioma)}</dd>
            <dt class="mt-1 text-[0.6875rem] uppercase leading-snug tracking-wide text-tinta-suave">{m.etiqueta[idioma]}</dt>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <a
    href={ruta(`/${idioma}/casos/${c.slug}/`)}
    class="group mt-auto flex min-h-12 items-center justify-between border-t border-tinta/10 bg-superficie/60 px-6 py-4 text-sm font-semibold text-tinta hover:bg-superficie sm:px-7"
  >
    {t.verCasoCompleto}
    <span class="flex size-7 items-center justify-center rounded-full bg-rojo/10 text-rojo transition group-hover:translate-x-1">
      <Icono nombre="flecha" size={16} />
    </span>
  </a>
</article>
