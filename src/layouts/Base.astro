---
import '../styles/global.css';
import { perfil, type Idioma } from '../data/perfil';

interface Props {
  idioma: Idioma;
  titulo: string;
  descripcion: string;
  alternativa?: string; // ruta equivalente en el otro idioma
}
const { idioma, titulo, descripcion, alternativa } = Astro.props;
const canonica = new URL(Astro.url.pathname, perfil.url).href;
const otro = idioma === 'es' ? 'en' : 'es';
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {alternativa && <link rel="alternate" hreflang={otro} href={new URL(alternativa, perfil.url).href} />}
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b1f4d" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ idioma }}>
      try { localStorage.setItem('idioma', idioma); } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
